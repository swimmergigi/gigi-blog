---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			.intro {
				margin-bottom: 3em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.intro p {
				color: rgb(var(--gray-dark));
				line-height: 1.8;
				font-size: 1.05em;
			}
			.posts-heading {
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1.5em;
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			ul li {
				padding: 1.2em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li:last-child {
				border-bottom: none;
			}
			ul li a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			ul li a:hover h3 {
				color: rgb(var(--accent));
			}
			h3 {
				margin: 0 0 0.3em 0;
				font-size: 1.1em;
				line-height: 1.4;
				transition: color 0.2s;
			}
			.date {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.all-posts {
				display: inline-block;
				margin-top: 2em;
				font-size: 0.9em;
				color: rgb(var(--accent));
				text-decoration: none;
			}
			.all-posts:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p>
					IT 현업에서 9년째 일하고 있습니다. AI가 내 일을 바꾸는 걸 직접 겪으면서,
					그 경험을 있는 그대로 씁니다.
				</p>
				<p>
					생산성이 향상됐다는 이야기가 아닙니다. AI와 비교해보니 내가 해온 게
					어떻게 보이기 시작했는지, 그 불편한 관찰을 기록합니다.
				</p>
			</section>

			<p class="posts-heading">최근 글</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
			<a href="/blog" class="all-posts">모든 글 보기 →</a>
		</main>
		<Footer />
	</body>
</html>
