---
const today = new Date();
---

<footer>
	<span>© {today.getFullYear()} gigi</span>
	<span class="sep">·</span>
	<a href="mailto:YOUR_EMAIL">연락하기</a>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer a {
		color: rgb(var(--gray));
		text-decoration: underline;
	}
	footer a:hover {
		color: rgb(var(--gray-dark));
	}
	.sep {
		margin: 0 0.5em;
	}
</style>
